---
import type { SupportedLang } from "../i18n/config";
import { useTranslations } from "../i18n/utils";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const replacedCategories = [
  { key: "movementAi", index: "01" },
  { key: "cameraAndTransfer", index: "02" },
  { key: "hudAndPictures", index: "03" },
  { key: "templatesAndState", index: "04" },
  { key: "layersAndTiles", index: "05" },
  { key: "inputsAndDebug", index: "06" }
];
---

<section id="no-plugins" class="relative py-20 sm:py-28 border-t border-[#101b17]/12 dark:border-teal-400/15 bg-[#eae8df]/60 dark:bg-[#08120f]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      chapterNum="03"
      badge={t("noPlugins.badge")}
      title={t("noPlugins.title")}
      subtitle={t("noPlugins.subtitle")}
      accentColor="amber"
    />

    <!-- Diagnostic Diff Comparison Ledger -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-12">
      <!-- Legacy RPG Maker Plugin Stack -->
      <div class="lg:col-span-5 rounded-2xl border border-rose-500/30 bg-[#f9f5f5] dark:bg-[#140c0f] p-6 sm:p-7 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between border-b border-rose-500/20 pb-3.5 mb-5">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-rose-500/20 font-mono text-xs font-bold text-rose-600 dark:text-rose-400">
                !
              </span>
              <h3 class="font-display text-base sm:text-lg font-bold text-[#101b17] dark:text-rose-100">
                {t("noPlugins.oldWayTitle")}
              </h3>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded bg-rose-500/15 text-rose-700 dark:text-rose-300 font-bold">
              LEGACY
            </span>
          </div>
          <p class="font-mono text-xs text-rose-700/80 dark:text-rose-300/75 mb-4">
            // {t("noPlugins.oldWaySubtitle")}
          </p>

          <ul class="space-y-3 text-xs sm:text-sm text-[#3c2a2d] dark:text-rose-100/80">
            <li class="flex items-start gap-2.5">
              <span class="font-mono text-rose-500 font-bold shrink-0">[-]</span>
              <span>{t("noPlugins.oldPoint1")}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="font-mono text-rose-500 font-bold shrink-0">[-]</span>
              <span>{t("noPlugins.oldPoint2")}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="font-mono text-rose-500 font-bold shrink-0">[-]</span>
              <span>{t("noPlugins.oldPoint3")}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="font-mono text-rose-500 font-bold shrink-0">[-]</span>
              <span>{t("noPlugins.oldPoint4")}</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- RPG Weaver Native Core Architecture -->
      <div class="lg:col-span-7 weaver-card corner-ticks rounded-2xl border-2 border-teal-600/40 dark:border-teal-400/40 bg-gradient-to-br from-white via-[#f3faf8] to-[#f8f4e8] dark:from-[#0b1c17] dark:via-[#0d221c] dark:to-[#171b12] p-6 sm:p-8 shadow-xl">
        <div class="flex items-center justify-between border-b border-teal-600/20 dark:border-teal-400/20 pb-3.5 mb-5">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-teal-500/20 font-mono text-xs font-bold text-teal-700 dark:text-teal-300">
              ✓
            </span>
            <h3 class="font-display text-lg sm:text-xl font-bold text-[#101b17] dark:text-white">
              {t("noPlugins.newWayTitle")}
            </h3>
          </div>
          <span class="font-mono text-[10px] uppercase tracking-wider px-2.5 py-1 rounded bg-teal-600 dark:bg-teal-400 text-white dark:text-[#06100e] font-bold">
            {t("noPlugins.builtInBadge")}
          </span>
        </div>

        <p class="font-mono text-xs text-teal-800 dark:text-amber-300/90 mb-5">
          // {t("noPlugins.newWaySubtitle")}
        </p>

        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-[#152620] dark:text-teal-50">
          <li class="rounded-xl border border-teal-600/15 dark:border-teal-400/15 bg-white/70 dark:bg-[#07120f]/70 p-3.5 flex items-start gap-2.5">
            <span class="font-mono text-teal-600 dark:text-teal-400 font-bold shrink-0">[+]</span>
            <span>{t("noPlugins.newPoint1")}</span>
          </li>
          <li class="rounded-xl border border-teal-600/15 dark:border-teal-400/15 bg-white/70 dark:bg-[#07120f]/70 p-3.5 flex items-start gap-2.5">
            <span class="font-mono text-teal-600 dark:text-teal-400 font-bold shrink-0">[+]</span>
            <span>{t("noPlugins.newPoint2")}</span>
          </li>
          <li class="rounded-xl border border-teal-600/15 dark:border-teal-400/15 bg-white/70 dark:bg-[#07120f]/70 p-3.5 flex items-start gap-2.5">
            <span class="font-mono text-teal-600 dark:text-teal-400 font-bold shrink-0">[+]</span>
            <span>{t("noPlugins.newPoint3")}</span>
          </li>
          <li class="rounded-xl border border-teal-600/15 dark:border-teal-400/15 bg-white/70 dark:bg-[#07120f]/70 p-3.5 flex items-start gap-2.5">
            <span class="font-mono text-teal-600 dark:text-teal-400 font-bold shrink-0">[+]</span>
            <span>{t("noPlugins.newPoint4")}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- 6 Native Core Modules Matrix -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 rounded-2xl border border-[#101b17]/15 dark:border-teal-400/20 overflow-hidden bg-[#101b17]/10 dark:bg-teal-400/15 gap-px">
      {replacedCategories.map((cat) => (
        <div class="bg-[#faf9f4] dark:bg-[#0a1613] p-6 flex flex-col justify-between hover:bg-white dark:hover:bg-[#0e1f1b] transition-colors">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="font-mono text-xs font-bold text-amber-600 dark:text-amber-400">
                MODULE // {cat.index}
              </span>
              <span class="rounded border border-teal-600/25 dark:border-teal-400/25 bg-teal-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-teal-800 dark:text-teal-300">
                {t(`noPlugins.cards.${cat.key}.tag`)}
              </span>
            </div>
            <h4 class="font-display text-lg font-bold text-[#101b17] dark:text-white mb-2">
              {t(`noPlugins.cards.${cat.key}.title`)}
            </h4>
            <p class="text-xs sm:text-sm text-[#364943] dark:text-teal-100/70 leading-relaxed">
              {t(`noPlugins.cards.${cat.key}.desc`)}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
