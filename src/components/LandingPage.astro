---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "./Navbar.astro";
import SectionHeader from "./SectionHeader.astro";
import AppWindowFrame from "./AppWindowFrame.astro";
import FeatureShowcaseCard from "./FeatureShowcaseCard.astro";
import NoPluginsBanner from "./NoPluginsBanner.astro";
import type { SupportedLang } from "../i18n/config";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface FeatureDef {
  key: string;
  mediaSrc: string;
  posterSrc?: string;
  isVideo?: boolean;
  featured?: boolean;
  mediaPosition?: "left" | "right";
  accentColor?: "teal" | "amber" | "emerald" | "cyan" | "violet";
}

// Engine Architecture: System & Pixi.js Performance (5 features)
const systemFeatures: FeatureDef[] = [
  {
    key: "pixiPerformance",
    mediaSrc: "/media/feat-pixi-performance.webm",
    posterSrc: "/media/feat-pixi-performance.webp",
    isVideo: true,
    featured: true,
    mediaPosition: "left",
    accentColor: "teal"
  },
  {
    key: "customInputs",
    mediaSrc: "/media/feat-custom-inputs.webp",
    accentColor: "teal"
  },
  {
    key: "customTileSize",
    mediaSrc: "/media/feat-tile-size.webp",
    accentColor: "teal"
  },
  {
    key: "customViewport",
    mediaSrc: "/media/feat-viewport-dimensions.webp",
    featured: true,
    mediaPosition: "right",
    accentColor: "teal"
  }
];

// Engine Architecture: Infinite Mapping & Pro Asset Pipeline (3 features)
const mappingFeatures: FeatureDef[] = [
  {
    key: "infiniteLayers",
    mediaSrc: "/media/feat-infinite-layers.webm",
    posterSrc: "/media/feat-infinite-layers.webp",
    isVideo: true,
    featured: true,
    mediaPosition: "left",
    accentColor: "emerald"
  },
  {
    key: "autotilesAnimated",
    mediaSrc: "/media/feat-autotiles-animated.webm",
    posterSrc: "/media/feat-autotiles-animated.webp",
    isVideo: true,
    accentColor: "emerald"
  },
  {
    key: "characterSlicing",
    mediaSrc: "/media/feat-character-slicing.webp",
    accentColor: "emerald"
  }
];

// Event Engine & AI (9 features including pixelMovement)
const eventFeatures: FeatureDef[] = [
  {
    key: "pixelMovement",
    mediaSrc: "/media/feat-pixel-movement.webm",
    posterSrc: "/media/feat-pixel-movement.webp",
    isVideo: true,
    featured: true,
    mediaPosition: "left",
    accentColor: "amber"
  },
  {
    key: "eventFollow",
    mediaSrc: "/media/feat-event-follow.webp",
    accentColor: "amber"
  },
  {
    key: "eventTouch",
    mediaSrc: "/media/feat-event-touch.webp",
    accentColor: "amber"
  },
  {
    key: "eventTransfer",
    mediaSrc: "/media/feat-event-transfer.webp",
    accentColor: "amber"
  },
  {
    key: "cameraTarget",
    mediaSrc: "/media/feat-camera-target.webp",
    accentColor: "amber"
  },
  {
    key: "eventTemplates",
    mediaSrc: "/media/feat-event-templates.webp",
    featured: true,
    mediaPosition: "right",
    accentColor: "amber"
  },
  {
    key: "multiAreaEvents",
    mediaSrc: "/media/feat-multi-area.webp",
    accentColor: "amber"
  },
  {
    key: "stackedEvents",
    mediaSrc: "/media/feat-stacked-events.webp",
    accentColor: "amber"
  },
  {
    key: "savePosition",
    mediaSrc: "/media/feat-save-position.webp",
    featured: true,
    mediaPosition: "left",
    accentColor: "amber"
  }
];

// Built-In HUD, Visuals & Atmosphere (4 features)
const visualFeatures: FeatureDef[] = [
  {
    key: "controlFogs",
    mediaSrc: "/media/feat-control-fogs.webm",
    posterSrc: "/media/feat-control-fogs.webp",
    isVideo: true,
    featured: true,
    mediaPosition: "left",
    accentColor: "cyan"
  },
  {
    key: "cropPicture",
    mediaSrc: "/media/feat-crop-picture.webp",
    featured: true,
    mediaPosition: "right",
    accentColor: "cyan"
  },
  {
    key: "picturePreview",
    mediaSrc: "/media/feat-picture-preview.webp",
    accentColor: "cyan"
  },
  {
    key: "messageTypewriting",
    mediaSrc: "/media/feat-message-typewriting.webp",
    accentColor: "cyan"
  }
];

// Fast Workflow, Instant Filtering & Easy Debug (2 features)
const workflowFeatures: FeatureDef[] = [
  {
    key: "filterableLists",
    mediaSrc: "/media/feat-filterable-lists.webm",
    posterSrc: "/media/feat-filterable-lists.webp",
    isVideo: true,
    accentColor: "violet"
  },
  {
    key: "easyDebug",
    mediaSrc: "/media/feat-easy-debug.webp",
    accentColor: "violet"
  }
];
---

<BaseLayout lang={lang} title={t("meta.title")} description={t("meta.description")}>
  <Navbar lang={lang} />

  <main class="bg-studio-grid min-h-screen">
    <!-- ==========================================
         GRAND HERO STAGE
         ========================================== -->
    <section class="relative overflow-hidden pt-8 pb-16 sm:pt-14 sm:pb-24">
      <!-- Ambient Studio Radial Glows -->
      <div
        class="pointer-events-none absolute -top-32 left-1/4 h-[32rem] w-[32rem] rounded-full bg-emerald-500/12 dark:bg-emerald-400/10 blur-3xl -z-10"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute top-20 right-1/4 h-[28rem] w-[28rem] rounded-full bg-cyan-500/12 dark:bg-cyan-400/10 blur-3xl -z-10"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
          <!-- Left Column: Editorial Headline, Badges & Actions -->
          <div class="lg:col-span-5 space-y-6">
            <div class="inline-flex items-center gap-3 rounded-xl border border-black/10 dark:border-white/10 bg-white/80 dark:bg-[#0c1411]/90 p-2 pr-4 shadow-sm backdrop-blur-md">
              <img
                src="/rpgweaver-logo.webp"
                alt={t("brand.logoAlt")}
                width="44"
                height="44"
                class="h-11 w-11 object-contain drop-shadow-sm shrink-0"
              />
              <div class="font-mono text-[11px] leading-tight">
                <div class="font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">
                  {t("brand.name")} // STUDIO
                </div>
                <div class="text-[#4a6058] dark:text-teal-200/75 mt-0.5">
                  {t("hero.eyebrow")}
                </div>
              </div>
            </div>

            <h1 class="font-display text-4xl sm:text-5xl xl:text-6xl font-bold tracking-tight text-[#101b17] dark:text-white leading-[1.06]">
              <span class="block">{t("hero.titleLine1")}</span>
              <span class="block mt-1.5 bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-500 dark:from-emerald-300 dark:via-teal-300 dark:to-cyan-300 bg-clip-text text-transparent">
                {t("hero.titleLine2")}
              </span>
            </h1>

            <p class="text-sm sm:text-base text-[#334740] dark:text-teal-100/80 leading-relaxed">
              {t("hero.subtitle")}
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a
                href="https://rpg-weaver.web.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 dark:from-emerald-400 dark:via-teal-400 dark:to-cyan-400 px-6 py-3.5 text-sm font-extrabold text-white dark:text-[#06100e] shadow-lg shadow-emerald-600/25 dark:shadow-emerald-400/20 hover:opacity-95 transition transform hover:-translate-y-0.5"
              >
                <span>{t("hero.primaryCta")}</span>
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                </svg>
              </a>

              <a
                href="#features"
                class="inline-flex items-center gap-2 rounded-xl border border-black/15 dark:border-white/15 bg-white/80 dark:bg-[#0c1613]/90 px-5 py-3.5 text-sm font-bold text-[#101b17] dark:text-teal-100 hover:border-emerald-600 dark:hover:border-emerald-400 transition backdrop-blur-md"
              >
                <span>{t("hero.secondaryCta")}</span>
              </a>
            </div>

            <div class="flex items-center gap-2 font-mono text-[11px] text-[#495f57] dark:text-teal-200/65">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>{t("hero.noInstallNote")}</span>
            </div>
          </div>

          <!-- Right Column: Interactive Workspace Viewport Stage (Prominent Media Frame) -->
          <div class="lg:col-span-7">
            <div class="weaver-card rounded-3xl p-3 sm:p-5 shadow-2xl">
              <!-- Integrated Mode Switcher Bar -->
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5 px-1.5">
                <div class="flex items-center gap-2 font-mono text-xs font-bold text-emerald-800 dark:text-emerald-300">
                  <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span>WEAVER STUDIO // OAKWOOD_VILLAGE.MAP</span>
                </div>

                <div class="inline-flex rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-black/30 p-1">
                  <button
                    type="button"
                    data-hero-tab="image"
                    class="hero-media-tab rounded-lg px-3 py-1 font-mono text-[11px] font-bold transition cursor-pointer bg-emerald-700 dark:bg-emerald-400 text-white dark:text-[#06100e]"
                  >
                    {t("hero.imageTabLabel")}
                  </button>
                  <button
                    type="button"
                    data-hero-tab="video"
                    class="hero-media-tab rounded-lg px-3 py-1 font-mono text-[11px] font-bold transition cursor-pointer text-[#3b4f48] dark:text-teal-200/75"
                  >
                    {t("hero.videoTabLabel")}
                  </button>
                </div>
              </div>

              <div id="hero-panel-image">
                <AppWindowFrame
                  mediaSrc="/media/hero-main.webp"
                  headerTitle={t("hero.windowTitle")}
                  alt={t("hero.screenshotAlt")}
                  caption={t("hero.screenshotCaption")}
                  priority={true}
                  accentColor="emerald"
                />
              </div>

              <div id="hero-panel-video" class="hidden">
                <AppWindowFrame
                  mediaSrc="/media/hero-demo.webm"
                  posterSrc="/media/hero-main.webp"
                  headerTitle={t("hero.windowTitle")}
                  alt={t("hero.screenshotAlt")}
                  caption={t("hero.screenshotCaption")}
                  isVideo={true}
                  accentColor="emerald"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Telemetry Stats Ledger -->
        <div class="mt-14 rounded-2xl border border-black/10 dark:border-white/10 bg-white/80 dark:bg-[#0c1613]/90 backdrop-blur-md overflow-hidden shadow-lg">
          <div class="grid grid-cols-2 lg:grid-cols-4 divide-y lg:divide-y-0 divide-x divide-black/10 dark:divide-white/10">
            <div class="p-5 sm:px-7 flex items-center gap-4">
              <div class="font-display text-3xl sm:text-4xl font-bold text-emerald-700 dark:text-emerald-300">
                {t("hero.stats.s1Value")}
              </div>
              <div class="font-mono text-xs font-semibold text-[#364943] dark:text-teal-100/80 leading-snug">
                {t("hero.stats.s1Label")}
              </div>
            </div>

            <div class="p-5 sm:px-7 flex items-center gap-4">
              <div class="font-display text-3xl sm:text-4xl font-bold text-amber-600 dark:text-amber-300">
                {t("hero.stats.s2Value")}
              </div>
              <div class="font-mono text-xs font-semibold text-[#364943] dark:text-teal-100/80 leading-snug">
                {t("hero.stats.s2Label")}
              </div>
            </div>

            <div class="p-5 sm:px-7 flex items-center gap-4">
              <div class="font-display text-3xl sm:text-4xl font-bold text-teal-600 dark:text-teal-300">
                {t("hero.stats.s3Value")}
              </div>
              <div class="font-mono text-xs font-semibold text-[#364943] dark:text-teal-100/80 leading-snug">
                {t("hero.stats.s3Label")}
              </div>
            </div>

            <div class="p-5 sm:px-7 flex items-center gap-4">
              <div class="font-display text-3xl sm:text-4xl font-bold text-cyan-600 dark:text-cyan-300">
                {t("hero.stats.s4Value")}
              </div>
              <div class="font-mono text-xs font-semibold text-[#364943] dark:text-teal-100/80 leading-snug">
                {t("hero.stats.s4Label")}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="h-px w-full studio-divider"></div>

    <!-- ==========================================
         CORE ENGINE ARCHITECTURE: SYSTEM & MAPPING
         ========================================== -->
    <section id="engine" class="py-20 sm:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-28">
        <!-- System & Pixi.js 60 FPS Runtime -->
        <div id="system">
          <SectionHeader
            badge={t("sections.system.badge")}
            title={t("sections.system.title")}
            subtitle={t("sections.system.subtitle")}
            accentColor="teal"
          />

          <!-- Spacious Studio Showcase Grid (Media takes maximum visual space!) -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
            {systemFeatures.map((feat) => (
              <FeatureShowcaseCard
                id={`feat-${feat.key}`}
                badge={t(`features.${feat.key}.badge`)}
                replacesPlugin={t(`features.${feat.key}.replaces`)}
                title={t(`features.${feat.key}.title`)}
                description={t(`features.${feat.key}.description`)}
                bullets={[
                  t(`features.${feat.key}.b1`),
                  t(`features.${feat.key}.b2`),
                  t(`features.${feat.key}.b3`)
                ]}
                mediaSrc={feat.mediaSrc}
                posterSrc={feat.posterSrc}
                mediaCaption={t(`features.${feat.key}.caption`)}
                isVideo={feat.isVideo}
                featured={feat.featured}
                mediaPosition={feat.mediaPosition}
                category="system"
                accentColor={feat.accentColor || "teal"}
              />
            ))}
          </div>
        </div>

        <!-- Infinite Map Layers & Spritesheet Slicing -->
        <div id="mapping">
          <SectionHeader
            badge={t("sections.mapping.badge")}
            title={t("sections.mapping.title")}
            subtitle={t("sections.mapping.subtitle")}
            accentColor="emerald"
          />

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
            {mappingFeatures.map((feat) => (
              <FeatureShowcaseCard
                id={`feat-${feat.key}`}
                badge={t(`features.${feat.key}.badge`)}
                replacesPlugin={t(`features.${feat.key}.replaces`)}
                title={t(`features.${feat.key}.title`)}
                description={t(`features.${feat.key}.description`)}
                bullets={[
                  t(`features.${feat.key}.b1`),
                  t(`features.${feat.key}.b2`),
                  t(`features.${feat.key}.b3`)
                ]}
                mediaSrc={feat.mediaSrc}
                posterSrc={feat.posterSrc}
                mediaCaption={t(`features.${feat.key}.caption`)}
                isVideo={feat.isVideo}
                featured={feat.featured}
                mediaPosition={feat.mediaPosition}
                category="mapping"
                accentColor={feat.accentColor || "emerald"}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         FEATURES SHOWCASE: EVENTS, HUD & WORKFLOW
         ========================================== -->
    <section id="features" class="py-20 sm:py-28 border-t border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-black/40">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-28">
        <!-- Next-Gen Event Engine & AI -->
        <div id="events">
          <SectionHeader
            badge={t("sections.events.badge")}
            title={t("sections.events.title")}
            subtitle={t("sections.events.subtitle")}
            accentColor="amber"
          />

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
            {eventFeatures.map((feat) => (
              <FeatureShowcaseCard
                id={`feat-${feat.key}`}
                badge={t(`features.${feat.key}.badge`)}
                replacesPlugin={t(`features.${feat.key}.replaces`)}
                title={t(`features.${feat.key}.title`)}
                description={t(`features.${feat.key}.description`)}
                bullets={[
                  t(`features.${feat.key}.b1`),
                  t(`features.${feat.key}.b2`),
                  t(`features.${feat.key}.b3`)
                ]}
                mediaSrc={feat.mediaSrc}
                posterSrc={feat.posterSrc}
                mediaCaption={t(`features.${feat.key}.caption`)}
                isVideo={feat.isVideo}
                featured={feat.featured}
                mediaPosition={feat.mediaPosition}
                category="events"
                accentColor={feat.accentColor || "amber"}
              />
            ))}
          </div>
        </div>

        <!-- Built-In HUD, Visuals & Atmosphere -->
        <div id="visuals">
          <SectionHeader
            badge={t("sections.visuals.badge")}
            title={t("sections.visuals.title")}
            subtitle={t("sections.visuals.subtitle")}
            accentColor="cyan"
          />

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
            {visualFeatures.map((feat) => (
              <FeatureShowcaseCard
                id={`feat-${feat.key}`}
                badge={t(`features.${feat.key}.badge`)}
                replacesPlugin={t(`features.${feat.key}.replaces`)}
                title={t(`features.${feat.key}.title`)}
                description={t(`features.${feat.key}.description`)}
                bullets={[
                  t(`features.${feat.key}.b1`),
                  t(`features.${feat.key}.b2`),
                  t(`features.${feat.key}.b3`)
                ]}
                mediaSrc={feat.mediaSrc}
                posterSrc={feat.posterSrc}
                mediaCaption={t(`features.${feat.key}.caption`)}
                isVideo={feat.isVideo}
                featured={feat.featured}
                mediaPosition={feat.mediaPosition}
                category="visuals"
                accentColor={feat.accentColor || "cyan"}
              />
            ))}
          </div>
        </div>

        <!-- Fast Workflow, Instant Filtering & Easy Debug -->
        <div id="workflow">
          <SectionHeader
            badge={t("sections.workflow.badge")}
            title={t("sections.workflow.title")}
            subtitle={t("sections.workflow.subtitle")}
            accentColor="violet"
          />

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
            {workflowFeatures.map((feat) => (
              <FeatureShowcaseCard
                id={`feat-${feat.key}`}
                badge={t(`features.${feat.key}.badge`)}
                replacesPlugin={t(`features.${feat.key}.replaces`)}
                title={t(`features.${feat.key}.title`)}
                description={t(`features.${feat.key}.description`)}
                bullets={[
                  t(`features.${feat.key}.b1`),
                  t(`features.${feat.key}.b2`),
                  t(`features.${feat.key}.b3`)
                ]}
                mediaSrc={feat.mediaSrc}
                posterSrc={feat.posterSrc}
                mediaCaption={t(`features.${feat.key}.caption`)}
                isVideo={feat.isVideo}
                featured={feat.featured}
                mediaPosition={feat.mediaPosition}
                category="workflow"
                accentColor={feat.accentColor || "violet"}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         THE ZERO-PLUGIN LEDGER
         ========================================== -->
    <NoPluginsBanner lang={lang} />

    <!-- ==========================================
         CALL TO ACTION STAGE
         ========================================== -->
    <section class="py-20 sm:py-28 border-t border-black/10 dark:border-white/10 relative overflow-hidden">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <div class="weaver-card rounded-3xl p-8 sm:p-14 shadow-2xl space-y-6">
          <span class="inline-flex items-center gap-2 rounded-lg border border-emerald-600/30 dark:border-emerald-400/30 bg-emerald-500/10 px-3 py-1 font-mono text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>{t("cta.badge")}</span>
          </span>

          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#101b17] dark:text-white max-w-3xl mx-auto leading-tight">
            {t("cta.title")}
          </h2>

          <p class="text-sm sm:text-base text-[#364943] dark:text-teal-100/75 max-w-2xl mx-auto leading-relaxed">
            {t("cta.subtitle")}
          </p>

          <div class="flex flex-wrap items-center justify-center gap-3.5 pt-4">
            <a
              href="https://rpg-weaver.web.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 dark:from-emerald-400 dark:via-teal-400 dark:to-cyan-400 px-7 py-4 text-sm font-extrabold text-white dark:text-[#06100e] shadow-xl hover:opacity-95 transition transform hover:-translate-y-0.5"
            >
              <span>{t("cta.primaryBtn")}</span>
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
              </svg>
            </a>

            <a
              href="#features"
              class="inline-flex items-center gap-2 rounded-xl border border-black/15 dark:border-white/15 bg-white dark:bg-[#0c1613] px-6 py-4 text-sm font-bold text-[#101b17] dark:text-teal-100 hover:border-emerald-600 dark:hover:border-emerald-400 transition"
            >
              <span>{t("cta.secondaryBtn")}</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ==========================================
       MINIMAL PROFESSIONAL FOOTER
       ========================================== -->
  <footer class="border-t border-black/10 dark:border-white/10 py-12 bg-white/80 dark:bg-[#060a08]/80 backdrop-blur-md">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3.5">
        <img
          src="/rpgweaver-icon.webp"
          alt={t("brand.logoAlt")}
          width="36"
          height="36"
          class="h-9 w-9 rounded-xl ring-1 ring-emerald-500/30"
        />
        <div>
          <div class="font-display text-sm font-bold text-[#101b17] dark:text-white">{t("brand.name")}</div>
          <p class="text-xs text-[#435850] dark:text-teal-200/60 max-w-md">{t("footer.description")}</p>
        </div>
      </div>

      <div class="flex flex-col sm:items-end gap-1.5 font-mono text-xs text-[#435850] dark:text-teal-200/60">
        <span>{t("footer.copyright")}</span>
      </div>
    </div>
  </footer>

  <!-- ==========================================
       FULLSCREEN MEDIA LIGHTBOX MODAL
       ========================================== -->
  <div
    id="weaver-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 sm:p-8 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative w-full max-w-6xl rounded-2xl border border-white/15 bg-[#07110e] shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between border-b border-white/10 bg-[#0b1915] px-4 py-3">
        <span id="weaver-lightbox-title" class="font-mono text-xs font-bold text-emerald-300 truncate"></span>
        <button
          type="button"
          id="weaver-lightbox-close"
          aria-label={t("explorer.closeModal")}
          class="rounded-lg border border-white/15 bg-white/5 px-3 py-1 font-mono text-xs font-bold text-white hover:bg-emerald-400 hover:text-[#06100e] transition cursor-pointer"
        >
          ESC ✕
        </button>
      </div>

      <div class="relative bg-black flex items-center justify-center min-h-[300px] max-h-[82vh] overflow-hidden">
        <img
          id="weaver-lightbox-image"
          src=""
          alt=""
          class="max-h-[82vh] w-auto max-w-full object-contain hidden"
        />
        <video
          id="weaver-lightbox-video"
          src=""
          controls
          autoplay
          loop
          playsinline
          class="max-h-[82vh] w-auto max-w-full object-contain hidden"
        ></video>
      </div>

      <div class="border-t border-white/10 bg-[#0b1915] px-4 py-2.5">
        <p id="weaver-lightbox-caption" class="font-mono text-xs text-emerald-100/70 truncate"></p>
      </div>
    </div>
  </div>
  <!-- ==========================================
       BACK TO TOP FLOATING ACTION BUTTON
       ========================================== -->
  <button
    type="button"
    id="back-to-top-btn"
    aria-label={lang === "it" ? "Torna all'inizio della pagina" : "Return to top of page"}
    title={lang === "it" ? "Torna in alto" : "Back to top"}
    class="fixed bottom-6 right-6 z-40 group flex h-12 w-12 items-center justify-center rounded-full border border-black/10 dark:border-white/15 bg-white/90 dark:bg-[#0c1613]/90 text-[#101b17] dark:text-emerald-300 shadow-2xl shadow-black/15 dark:shadow-black/70 backdrop-blur-xl transition-all duration-300 cursor-pointer pointer-events-none opacity-0 translate-y-4 hover:scale-110 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-200 active:scale-95"
  >
    <svg class="h-5 w-5 transition-transform duration-200 group-hover:-translate-y-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 17a.75.75 0 01-.75-.75V5.612L5.29 9.77a.75.75 0 01-1.08-1.04l5.25-5.5a.75.75 0 011.08 0l5.25 5.5a.75.75 0 11-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0110 17z" clip-rule="evenodd" />
    </svg>
  </button>
</BaseLayout>

<script>
  // Back to Top floating button controller
  const backToTopBtn = document.getElementById("back-to-top-btn");

  window.addEventListener("scroll", () => {
    if (!backToTopBtn) return;
    if (window.scrollY > 400) {
      backToTopBtn.classList.remove("pointer-events-none", "opacity-0", "translate-y-4");
      backToTopBtn.classList.add("pointer-events-auto", "opacity-100", "translate-y-0");
    } else {
      backToTopBtn.classList.remove("pointer-events-auto", "opacity-100", "translate-y-0");
      backToTopBtn.classList.add("pointer-events-none", "opacity-0", "translate-y-4");
    }
  }, { passive: true });

  backToTopBtn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  // Hero Workspace Media Switcher
  const heroTabs = document.querySelectorAll<HTMLButtonElement>(".hero-media-tab");
  const heroPanelImage = document.getElementById("hero-panel-image");
  const heroPanelVideo = document.getElementById("hero-panel-video");

  heroTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const mode = tab.getAttribute("data-hero-tab");
      heroTabs.forEach((t) => {
        t.classList.remove("bg-emerald-700", "dark:bg-emerald-400", "text-white", "dark:text-[#06100e]");
        t.classList.add("text-[#3b4f48]", "dark:text-teal-200/75");
      });
      tab.classList.add("bg-emerald-700", "dark:bg-emerald-400", "text-white", "dark:text-[#06100e]");
      tab.classList.remove("text-[#3b4f48]", "dark:text-teal-200/75");

      if (mode === "video") {
        heroPanelImage?.classList.add("hidden");
        heroPanelVideo?.classList.remove("hidden");
        const video = heroPanelVideo?.querySelector("video");
        if (video) video.play().catch(() => {});
      } else {
        heroPanelVideo?.classList.add("hidden");
        heroPanelImage?.classList.remove("hidden");
        const video = heroPanelVideo?.querySelector("video");
        if (video) video.pause();
      }
    });
  });

  // Lightbox Modal Logic
  const lightbox = document.getElementById("weaver-lightbox");
  const lightboxClose = document.getElementById("weaver-lightbox-close");
  const lightboxTitle = document.getElementById("weaver-lightbox-title");
  const lightboxCaption = document.getElementById("weaver-lightbox-caption");
  const lightboxImg = document.getElementById("weaver-lightbox-image") as HTMLImageElement;
  const lightboxVid = document.getElementById("weaver-lightbox-video") as HTMLVideoElement;

  function openLightbox(mediaSrc: string, posterSrc: string, isVideo: boolean, title: string, caption: string) {
    if (!lightbox || !lightboxTitle || !lightboxCaption || !lightboxImg || !lightboxVid) return;

    lightboxTitle.textContent = title || "RPG Weaver Viewport";
    lightboxCaption.textContent = caption || "";

    if (isVideo) {
      lightboxImg.classList.add("hidden");
      lightboxVid.classList.remove("hidden");
      lightboxVid.poster = posterSrc;
      lightboxVid.src = mediaSrc;
      lightboxVid.load();
      lightboxVid.currentTime = 0;
      lightboxVid.play().catch(() => {});
    } else {
      lightboxVid.classList.add("hidden");
      lightboxVid.pause();
      lightboxImg.classList.remove("hidden");
      lightboxImg.src = mediaSrc;
      lightboxImg.alt = title;
    }

    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    if (!lightbox || !lightboxVid) return;
    lightboxVid.pause();
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const mediaSrc = trigger.getAttribute("data-media-src") || "";
      const posterSrc = trigger.getAttribute("data-poster-src") || "";
      const isVideo = trigger.getAttribute("data-is-video") === "true";
      const title = trigger.getAttribute("data-title") || "";
      const caption = trigger.getAttribute("data-caption") || "";

      if (mediaSrc) {
        openLightbox(mediaSrc, posterSrc, isVideo, title, caption);
      }
    });
  });

  lightboxClose?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
      closeLightbox();
    }
  });
</script>
