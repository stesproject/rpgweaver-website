---
import type { SupportedLang } from "../i18n/config";
import { useTranslations, getSwitchLocaleUrl } from "../i18n/utils";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const enHref = getSwitchLocaleUrl(Astro.url.pathname, "en");
const itHref = getSwitchLocaleUrl(Astro.url.pathname, "it");
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 dark:border-slate-800/80 bg-white/85 dark:bg-[#090912]/85 backdrop-blur-xl transition-colors">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a href={lang === "it" ? "/it" : "/"} class="flex items-center gap-3 group">
      <img
        src="/rpgweaver-icon.png"
        alt={t("brand.logoAlt")}
        width="36"
        height="36"
        class="h-9 w-9 rounded-xl shadow-md shadow-violet-500/15 ring-1 ring-slate-900/10 dark:ring-white/10 transition-transform group-hover:scale-105"
      />
      <span class="text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
        {t("brand.name")}
      </span>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="#no-plugins" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
        {t("nav.noPlugins")}
      </a>
      <a href="#events" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
        {t("nav.events")}
      </a>
      <a href="#visuals" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
        {t("nav.visuals")}
      </a>
      <a href="#mapping" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
        {t("nav.mapping")}
      </a>
      <a href="#workflow" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
        {t("nav.workflow")}
      </a>
      <a href="#system" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
        {t("nav.system")}
      </a>
    </nav>

    <!-- Actions & Language Switcher -->
    <div class="flex items-center gap-3">
      <button
        type="button"
        data-website-theme-toggle
        aria-label={t("nav.toggleThemeLabel")}
        title={t("nav.toggleThemeLabel")}
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-[#131320] text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition cursor-pointer"
      >
        <!-- Sun icon (visible in dark mode) -->
        <svg class="hidden dark:block h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5" />
          <path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <!-- Moon icon (visible in light mode) -->
        <svg class="block dark:hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
        </svg>
      </button>

      <div
        class="flex items-center rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-[#131320] p-0.5 text-xs font-semibold"
        aria-label={t("nav.switchLangLabel")}
      >
        <a
          href={enHref}
          class:list={[
            "rounded-md px-2.5 py-1 transition",
            lang === "en"
              ? "bg-violet-600 text-white font-bold shadow-xs"
              : "text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
          ]}
        >
          {t("nav.langEn")}
        </a>
        <a
          href={itHref}
          class:list={[
            "rounded-md px-2.5 py-1 transition",
            lang === "it"
              ? "bg-violet-600 text-white font-bold shadow-xs"
              : "text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
          ]}
        >
          {t("nav.langIt")}
        </a>
      </div>

      <a
        href="https://rpg-weaver.web.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 px-4 py-2 text-xs font-bold text-white shadow-md shadow-violet-500/25 hover:from-violet-500 hover:via-purple-500 hover:to-indigo-500 transition"
      >
        <span>{t("nav.launchApp")}</span>
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>("[data-website-theme-toggle]");
  toggleButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      const nextTheme = isDark ? "light" : "dark";
      const setTheme = (window as any).__setWebsiteTheme;
      if (typeof setTheme === "function") {
        setTheme(nextTheme, true);
      } else {
        document.documentElement.classList.toggle("dark", nextTheme === "dark");
        document.documentElement.dataset.theme = nextTheme;
        window.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: nextTheme } }));
      }
    });
  });
</script>
