---
import type { SupportedLang } from "../i18n/config";
import { useTranslations, getSwitchLocaleUrl } from "../i18n/utils";

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const enHref = getSwitchLocaleUrl(Astro.url.pathname, "en");
const itHref = getSwitchLocaleUrl(Astro.url.pathname, "it");

// 22 Features organized into 4 balanced columns
const featureColumns = [
  {
    colTitle: lang === "it" ? "Movimento & IA Eventi" : "Movement & Event AI",
    accent: "text-amber-600 dark:text-amber-400 border-amber-500/30",
    pip: "bg-amber-500",
    features: [
      { key: "pixelMovement", title: t("features.pixelMovement.title") },
      { key: "eventFollow", title: t("features.eventFollow.title") },
      { key: "eventTouch", title: t("features.eventTouch.title") },
      { key: "eventTransfer", title: t("features.eventTransfer.title") },
      { key: "cameraTarget", title: t("features.cameraTarget.title") },
      { key: "savePosition", title: t("features.savePosition.title") },
    ]
  },
  {
    colTitle: lang === "it" ? "Mappa & Spawning" : "Map Canvas & Spawning",
    accent: "text-emerald-600 dark:text-emerald-400 border-emerald-500/30",
    pip: "bg-emerald-500",
    features: [
      { key: "eventTemplates", title: t("features.eventTemplates.title") },
      { key: "multiAreaEvents", title: t("features.multiAreaEvents.title") },
      { key: "stackedEvents", title: t("features.stackedEvents.title") },
      { key: "infiniteLayers", title: t("features.infiniteLayers.title") },
      { key: "autotilesAnimated", title: t("features.autotilesAnimated.title") },
      { key: "characterSlicing", title: t("features.characterSlicing.title") },
    ]
  },
  {
    colTitle: lang === "it" ? "HUD, Grafica & Nebbie" : "Visuals, HUD & Fogs",
    accent: "text-cyan-600 dark:text-cyan-400 border-cyan-500/30",
    pip: "bg-cyan-500",
    features: [
      { key: "cropPicture", title: t("features.cropPicture.title") },
      { key: "picturePreview", title: t("features.picturePreview.title") },
      { key: "controlFogs", title: t("features.controlFogs.title") },
      { key: "messageTypewriting", title: t("features.messageTypewriting.title") },
    ]
  },
  {
    colTitle: lang === "it" ? "Sistema, Debug & Pixi" : "System, Debug & Pixi",
    accent: "text-teal-600 dark:text-teal-400 border-teal-500/30",
    pip: "bg-teal-500",
    features: [
      { key: "customInputs", title: t("features.customInputs.title") },
      { key: "customTileSize", title: t("features.customTileSize.title") },
      { key: "customViewport", title: t("features.customViewport.title") },
      { key: "filterableLists", title: t("features.filterableLists.title") },
      { key: "easyDebug", title: t("features.easyDebug.title") },
      { key: "pixiPerformance", title: t("features.pixiPerformance.title") },
    ]
  }
];
---

<header class="sticky top-3 z-50 px-3 sm:px-6 pt-2">
  <div class="relative mx-auto flex h-13 max-w-4xl items-center justify-between rounded-full border border-[#101b17]/15 dark:border-teal-400/20 bg-[#faf9f4]/90 dark:bg-[#091512]/90 px-3 sm:px-4 shadow-xl shadow-teal-950/5 dark:shadow-black/50 backdrop-blur-xl transition-colors">
    <!-- Brand -->
    <a href={lang === "it" ? "/it" : "/"} class="flex items-center gap-2.5 group pl-1">
      <div class="relative flex h-8 w-8 items-center justify-center rounded-full bg-[#0c1a16] ring-1 ring-teal-500/40 overflow-hidden transition-transform group-hover:scale-105">
        <img
          src="/rpgweaver-icon.png"
          alt={t("brand.logoAlt")}
          width="32"
          height="32"
          class="h-full w-full object-cover"
        />
      </div>
      <span class="font-display text-sm sm:text-base font-bold tracking-tight text-[#101b17] dark:text-white">
        {t("brand.name")}
      </span>
    </a>

    <!-- Navigation Pill with Hover Features Dropdown -->
    <nav class="hidden md:flex items-center gap-1 rounded-full bg-[#eae8df]/80 dark:bg-[#0f211c]/90 px-2 py-1 text-xs font-semibold text-[#334740] dark:text-teal-100/80 border border-[#101b17]/5 dark:border-teal-400/10">
      <a
        href="#engine"
        class="rounded-full px-3 py-1 hover:bg-white dark:hover:bg-teal-500/15 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
      >
        {t("nav.engine")}
      </a>

      <!-- Features Dropdown Trigger Container -->
      <div class="relative group/features">
        <a
          href="#features"
          id="features-nav-trigger"
          class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 hover:bg-white dark:hover:bg-teal-500/15 hover:text-teal-700 dark:hover:text-teal-300 transition-colors cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>{t("nav.features")}</span>
          <svg class="h-3 w-3 text-teal-600/70 dark:text-teal-300/70 transition-transform duration-200 group-hover/features:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </a>

        <!-- Invisible bridge so cursor moving downward won't leave hover area -->
        <div
          id="features-dropdown-menu"
          class="pointer-events-none opacity-0 translate-y-1 group-hover/features:pointer-events-auto group-hover/features:opacity-100 group-hover/features:translate-y-0 group-focus-within/features:pointer-events-auto group-focus-within/features:opacity-100 group-focus-within/features:translate-y-0 fixed left-1/2 -translate-x-1/2 top-16 pt-2 z-50 w-[920px] max-w-[95vw] transition-all duration-200 ease-out"
        >
          <div class="rounded-2xl border border-[#101b17]/15 dark:border-teal-400/25 bg-[#faf9f4]/98 dark:bg-[#071310]/98 p-5 sm:p-6 shadow-2xl shadow-teal-950/25 dark:shadow-black/80 backdrop-blur-2xl">
            <!-- Header bar inside dropdown -->
            <div class="flex items-center justify-between border-b border-[#101b17]/10 dark:border-teal-400/15 pb-3 mb-4 text-xs font-mono">
              <div class="flex items-center gap-2 font-bold uppercase tracking-wider text-teal-900 dark:text-teal-200">
                <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>{t("nav.features")} // {lang === "it" ? "22 Funzioni Tutto Incluso" : "22 Core Built-In Features"}</span>
              </div>
              <a
                href="#features"
                class="feature-jump-link text-[11px] font-semibold text-teal-700 dark:text-teal-300 hover:underline"
              >
                {lang === "it" ? "Tutte le funzioni →" : "View all features →"}
              </a>
            </div>

            <!-- 4 Responsive Category Columns -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 text-left">
              {featureColumns.map((col) => (
                <div class="space-y-2">
                  <div class:list={["font-mono text-[10px] font-bold uppercase tracking-wider border-b pb-1.5", col.accent]}>
                    {col.colTitle}
                  </div>
                  <ul class="space-y-0.5">
                    {col.features.map((feat) => (
                      <li>
                        <a
                          href={`#feat-${feat.key}`}
                          class="feature-jump-link group/item flex items-start gap-1.5 rounded-lg px-2 py-1.5 text-[11px] leading-snug transition-colors text-[#22332d] dark:text-teal-100/80 hover:bg-teal-500/10 dark:hover:bg-teal-400/10 hover:text-teal-800 dark:hover:text-teal-200"
                        >
                          <span class:list={["mt-1 h-1.5 w-1.5 rounded-full shrink-0 transition-transform group-hover/item:scale-125", col.pip]}></span>
                          <span class="line-clamp-2">{feat.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <a
        href="#no-plugins"
        class="rounded-full px-3 py-1 hover:bg-white dark:hover:bg-teal-500/15 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
      >
        {t("nav.noPlugins")}
      </a>
    </nav>

    <!-- Compact Actions: Theme, Lang, Launch -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <button
        type="button"
        data-website-theme-toggle
        aria-label={t("nav.toggleThemeLabel")}
        title={t("nav.toggleThemeLabel")}
        class="flex h-8 w-8 items-center justify-center rounded-full border border-[#101b17]/12 dark:border-teal-400/20 bg-[#eae8df]/70 dark:bg-[#10231e] text-[#2c3f38] hover:text-teal-700 dark:text-teal-200/80 dark:hover:text-amber-300 transition cursor-pointer"
      >
        <!-- Sun icon (visible in dark mode) -->
        <svg class="hidden dark:block h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5" />
          <path stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <!-- Moon icon (visible in light mode) -->
        <svg class="block dark:hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
        </svg>
      </button>

      <div
        class="flex items-center rounded-full border border-[#101b17]/12 dark:border-teal-400/20 bg-[#eae8df]/70 dark:bg-[#10231e] p-0.5 font-mono text-[11px] font-bold"
        aria-label={t("nav.switchLangLabel")}
      >
        <a
          href={enHref}
          class:list={[
            "rounded-full px-2 py-0.5 transition",
            lang === "en"
              ? "bg-teal-700 dark:bg-teal-400 text-white dark:text-[#06100e]"
              : "text-[#425850] hover:text-[#101b17] dark:text-teal-200/70 dark:hover:text-white"
          ]}
        >
          {t("nav.langEn")}
        </a>
        <a
          href={itHref}
          class:list={[
            "rounded-full px-2 py-0.5 transition",
            lang === "it"
              ? "bg-teal-700 dark:bg-teal-400 text-white dark:text-[#06100e]"
              : "text-[#425850] hover:text-[#101b17] dark:text-teal-200/70 dark:hover:text-white"
          ]}
        >
          {t("nav.langIt")}
        </a>
      </div>

      <a
        href="https://rpg-weaver.web.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full bg-[#101b17] dark:bg-gradient-to-r dark:from-teal-400 dark:via-emerald-400 dark:to-amber-300 px-3.5 py-1.5 text-xs font-extrabold text-[#f4f3ec] dark:text-[#06100e] shadow-sm hover:opacity-90 transition"
      >
        <span>{t("nav.launchApp")}</span>
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Website theme toggle
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>("[data-website-theme-toggle]");
  toggleButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      const nextTheme = isDark ? "light" : "dark";
      const setTheme = (window as any).__setWebsiteTheme;
      if (typeof setTheme === "function") {
        setTheme(nextTheme, true);
      } else {
        document.documentElement.classList.toggle("dark", nextTheme === "dark");
        document.documentElement.dataset.theme = nextTheme;
        window.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: nextTheme } }));
      }
    });
  });

  // Feature dropdown jump links: close menu and highlight targeted card
  const jumpLinks = document.querySelectorAll<HTMLAnchorElement>(".feature-jump-link");
  const dropdownMenu = document.getElementById("features-dropdown-menu");

  jumpLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href");
      if (href && href.startsWith("#feat-")) {
        // Hide dropdown immediately on click
        if (dropdownMenu) {
          dropdownMenu.classList.add("hidden");
          setTimeout(() => {
            dropdownMenu.classList.remove("hidden");
          }, 600);
        }

        // Highlight targeted feature card
        const targetId = href.substring(1);
        const targetElem = document.getElementById(targetId);
        if (targetElem) {
          targetElem.classList.add("ring-2", "ring-teal-400", "ring-offset-4", "ring-offset-background");
          setTimeout(() => {
            targetElem.classList.remove("ring-2", "ring-teal-400", "ring-offset-4", "ring-offset-background");
          }, 1800);
        }
      }
    });
  });
</script>
