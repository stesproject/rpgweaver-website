---
import AppWindowFrame from "./AppWindowFrame.astro";

interface Props {
  id?: string;
  badge: string;
  replacesPlugin?: string;
  title: string;
  description: string;
  bullets: string[];
  mediaSrc: string;
  posterSrc?: string;
  mediaCaption: string;
  isVideo?: boolean;
  featured?: boolean;
  category?: string;
}

const {
  id,
  badge,
  replacesPlugin,
  title,
  description,
  bullets,
  mediaSrc,
  posterSrc,
  mediaCaption,
  isVideo = false,
  featured = false,
  category = "all"
} = Astro.props;
---

<article
  id={id}
  data-feature-card
  data-feature-category={category}
  class:list={[
    "weaver-card corner-ticks scroll-mt-24 rounded-2xl p-5 sm:p-6 flex flex-col justify-between shadow-lg shadow-teal-950/5 dark:shadow-black/40 transition-all duration-300",
    featured ? "lg:col-span-2" : "col-span-1"
  ]}
>
  {featured ? (
    <!-- Wide Bento Spotlight Layout (for Flagship Video Features) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center h-full">
      <div class="lg:col-span-7 order-1 lg:order-2">
        <AppWindowFrame
          mediaSrc={mediaSrc}
          posterSrc={posterSrc}
          headerTitle={badge}
          alt={title}
          caption={mediaCaption}
          isVideo={isVideo}
        />
      </div>

      <div class="lg:col-span-5 order-2 lg:order-1 flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center rounded-md border border-teal-600/30 dark:border-teal-400/30 bg-teal-600/10 dark:bg-teal-400/10 px-2.5 py-0.5 font-mono text-[11px] font-bold text-teal-800 dark:text-teal-300">
              {badge}
            </span>
            {replacesPlugin && (
              <span class="inline-flex items-center gap-1 rounded-md border border-amber-600/30 dark:border-amber-400/30 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-amber-800 dark:text-amber-300">
                <span>⚡</span>
                <span>{replacesPlugin}</span>
              </span>
            )}
          </div>

          <h3 class="font-display text-xl sm:text-2xl font-bold text-[#101b17] dark:text-white leading-snug">
            {title}
          </h3>

          <p class="text-xs sm:text-sm text-[#364943] dark:text-teal-100/75 leading-relaxed">
            {description}
          </p>
        </div>

        <ul class="space-y-2 border-t border-[#101b17]/10 dark:border-teal-400/15 pt-3.5">
          {bullets.map((bullet) => (
            <li class="flex items-start gap-2 text-xs text-[#22332d] dark:text-teal-50/85">
              <span class="mt-0.5 font-mono text-[11px] font-bold text-teal-600 dark:text-teal-400 shrink-0">
                →
              </span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  ) : (
    <!-- Compact Vertical Architectural Card Layout -->
    <div class="flex flex-col h-full justify-between space-y-5">
      <div class="space-y-4">
        <AppWindowFrame
          mediaSrc={mediaSrc}
          posterSrc={posterSrc}
          headerTitle={badge}
          alt={title}
          caption={mediaCaption}
          isVideo={isVideo}
        />

        <div class="flex flex-wrap items-center justify-between gap-1.5 pt-1">
          <span class="inline-flex items-center rounded-md border border-teal-600/25 dark:border-teal-400/25 bg-teal-600/10 dark:bg-teal-400/10 px-2 py-0.5 font-mono text-[10px] font-bold text-teal-800 dark:text-teal-300">
            {badge}
          </span>
          {replacesPlugin && (
            <span class="inline-flex items-center gap-1 rounded-md border border-amber-600/25 dark:border-amber-400/25 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-amber-800 dark:text-amber-300">
              <span>⚡</span>
              <span>{replacesPlugin}</span>
            </span>
          )}
        </div>

        <h3 class="font-display text-lg sm:text-xl font-bold text-[#101b17] dark:text-white leading-snug">
          {title}
        </h3>

        <p class="text-xs sm:text-sm text-[#364943] dark:text-teal-100/75 leading-relaxed">
          {description}
        </p>
      </div>

      <ul class="space-y-1.5 border-t border-[#101b17]/10 dark:border-teal-400/15 pt-3">
        {bullets.map((bullet) => (
          <li class="flex items-start gap-2 text-xs text-[#22332d] dark:text-teal-50/85">
            <span class="mt-0.5 font-mono text-[11px] font-bold text-teal-600 dark:text-teal-400 shrink-0">
              →
            </span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</article>
