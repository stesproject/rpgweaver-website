---
import AppWindowFrame from "./AppWindowFrame.astro";

interface Props {
  id?: string;
  badge?: string;
  replacesPlugin?: string;
  title: string;
  description: string;
  bullets: string[];
  mediaSrc: string;
  posterSrc?: string;
  mediaCaption: string;
  isVideo?: boolean;
  featured?: boolean;
  mediaPosition?: "left" | "right";
  category?: string;
  accentColor?: "teal" | "amber" | "emerald" | "cyan" | "violet";
}

const {
  id,
  replacesPlugin,
  title,
  description,
  bullets,
  mediaSrc,
  posterSrc,
  mediaCaption,
  isVideo = false,
  featured = false,
  mediaPosition = "left",
  category = "all",
  accentColor = "teal"
} = Astro.props;

const bulletArrowStyles: Record<string, string> = {
  emerald: "text-emerald-600 dark:text-emerald-400",
  amber: "text-amber-600 dark:text-amber-400",
  cyan: "text-cyan-600 dark:text-cyan-400",
  violet: "text-violet-600 dark:text-violet-400",
  teal: "text-teal-600 dark:text-teal-400"
};
---

<article
  id={id}
  data-feature-card
  data-feature-category={category}
  class:list={[
    "weaver-card scroll-mt-28 rounded-3xl p-6 sm:p-8 flex flex-col justify-between shadow-xl shadow-black/5 dark:shadow-black/60 transition-all duration-300",
    featured ? "col-span-full" : "col-span-1"
  ]}
>
  {featured ? (
    <!-- ==========================================
         FLAGSHIP FULL-WIDTH SPLIT SHOWCASE
         (Media takes ~65% width for maximum visual impact!)
         ========================================== -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center h-full">
      <!-- Media Viewport Frame (Takes 7 or 8 columns out of 12) -->
      <div
        class:list={[
          "lg:col-span-7 xl:col-span-8",
          mediaPosition === "right" ? "order-1 lg:order-2" : "order-1"
        ]}
      >
        <AppWindowFrame
          mediaSrc={mediaSrc}
          posterSrc={posterSrc}
          headerTitle={title}
          alt={title}
          caption={mediaCaption}
          isVideo={isVideo}
          accentColor={accentColor}
        />
      </div>

      <!-- Narrative & Architecture Specs (Takes 5 or 4 columns) -->
      <div
        class:list={[
          "lg:col-span-5 xl:col-span-4 flex flex-col justify-between space-y-6",
          mediaPosition === "right" ? "order-2 lg:order-1" : "order-2"
        ]}
      >
        <div class="space-y-4">
          <!-- Feature Title -->
          <h3 class="font-display text-2xl sm:text-3xl font-bold text-[#101b17] dark:text-white leading-tight tracking-tight">
            {title}
          </h3>

          <!-- Feature Description -->
          <p class="text-sm sm:text-base text-[#364943] dark:text-teal-100/80 leading-relaxed">
            {description}
          </p>
        </div>

        <!-- Capability Bullets -->
        <ul class="space-y-2.5 border-t border-[#101b17]/10 dark:border-white/10 pt-4">
          {bullets.map((bullet) => (
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-[#22332d] dark:text-teal-50/90 leading-snug">
              <span class:list={["mt-0.5 font-mono text-sm font-bold shrink-0", bulletArrowStyles[accentColor] || bulletArrowStyles.teal]}>
                →
              </span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  ) : (
    <!-- ==========================================
         EXPANSIVE 2-COLUMN STUDIO CARD
         (Media is prominent across 100% of the wide card!)
         ========================================== -->
    <div class="flex flex-col h-full justify-between space-y-6">
      <div class="space-y-5">
        <!-- Media Viewport (Commands full card width ~580px) -->
        <AppWindowFrame
          mediaSrc={mediaSrc}
          posterSrc={posterSrc}
          headerTitle={title}
          alt={title}
          caption={mediaCaption}
          isVideo={isVideo}
          accentColor={accentColor}
        />

        <!-- Feature Title -->
        <h3 class="font-display text-xl sm:text-2xl font-bold text-[#101b17] dark:text-white leading-snug">
          {title}
        </h3>

        <!-- Feature Description -->
        <p class="text-xs sm:text-sm text-[#364943] dark:text-teal-100/75 leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Capability Bullets -->
      <ul class="space-y-2 border-t border-[#101b17]/10 dark:border-white/10 pt-3.5">
        {bullets.map((bullet) => (
          <li class="flex items-start gap-2.5 text-xs text-[#22332d] dark:text-teal-50/85 leading-snug">
            <span class:list={["mt-0.5 font-mono text-xs font-bold shrink-0", bulletArrowStyles[accentColor] || bulletArrowStyles.teal]}>
              →
            </span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</article>
