---
interface Props {
  mediaSrc: string;
  posterSrc?: string;
  headerTitle: string;
  alt: string;
  caption?: string;
  isVideo?: boolean;
  priority?: boolean;
}

const {
  mediaSrc,
  posterSrc,
  headerTitle,
  alt,
  caption,
  isVideo = false,
  priority = false
} = Astro.props;
---

<figure
  class="group/frame relative rounded-xl border border-[#101b17]/15 dark:border-teal-400/20 bg-[#101b17] dark:bg-[#07110e] shadow-xl shadow-teal-950/10 dark:shadow-black/70 overflow-hidden cursor-pointer"
  data-lightbox-trigger
  data-media-src={mediaSrc}
  data-poster-src={posterSrc || ""}
  data-is-video={isVideo ? "true" : "false"}
  data-title={headerTitle}
  data-caption={caption || alt}
>
  <!-- Engine HUD Top Bar -->
  <div class="flex items-center justify-between border-b border-white/10 bg-[#14231e] dark:bg-[#0b1915] px-3.5 py-2 text-[11px] font-mono">
    <div class="flex items-center gap-2 min-w-0">
      <span class="truncate text-teal-100/90 font-medium">{headerTitle}</span>
    </div>

    <div class="flex items-center gap-2 shrink-0 text-teal-300/60">
      <span class="inline-flex h-5 w-5 items-center justify-center rounded bg-white/5 text-teal-200/80 group-hover/frame:bg-teal-400 group-hover/frame:text-[#06100e] transition-colors" title="Expand media">
        <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4h4M16 8V4h-4M4 12v4h4M16 12v4h-4" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Media Viewport -->
  <div class="relative bg-[#070f0c] aspect-16/10 w-full overflow-hidden">
    {isVideo ? (
      <video
        src={mediaSrc}
        poster={posterSrc}
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        class="h-full w-full object-cover transition-transform duration-500 group-hover/frame:scale-[1.015]"
      ></video>
    ) : (
      <img
        src={mediaSrc}
        alt={alt}
        loading={priority ? "eager" : "lazy"}
        class="h-full w-full object-cover transition-transform duration-500 group-hover/frame:scale-[1.015]"
      />
    )}
  </div>

  <!-- Optional Bottom Caption Readout -->
  {caption && (
    <figcaption class="border-t border-white/10 bg-[#0d1915] px-3.5 py-2 text-[11px] font-mono text-teal-100/70">
      <span class="truncate block">{caption}</span>
    </figcaption>
  )}
</figure>
